# ================================
# API Keys
# ================================
HUGGINGFACE_API_KEY=your_huggingface_api_key
IMGBB_API_KEY=your_imgbb_api_key
INSTAGRAM_PAGE_ID=your_instagram_page_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ================================
# App Settings
# ================================
BOT_USERNAME=your_bot_username
BOT_PASSWORD=your_secure_password
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ================================
# Database Configuration (MySQL - Aiven)
# ================================
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL_MODE=REQUIRED

# SSL Certificate (Optional - if needed)
DB_SSL_CA="-----BEGIN CERTIFICATE-----
your_certificate_here
-----END CERTIFICATE-----"

# ================================
# Connection URI
# ================================
DATABASE_URL=mysql://username:password@host:port/dbname?ssl-mode=REQUIRED

# ================================
# AI Services
# ================================
SARVAM_AI_KEY=your_sarvam_ai_key

# ================================
# Cloudinary Configuration
# ================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JSON2Video (Reel Generation)
JSON2VIDEO_API_KEY=your_api_key
